# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=hdfs-log-events

# Snowflake
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=PULSEOPS_WH
SNOWFLAKE_DATABASE=PULSEOPS
SNOWFLAKE_SCHEMA=CORE
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# GCS (Spark Structured Streaming checkpoint location)
# Use a local path for Days 1-11. Replace with gs://... during GCP deployment.
GCS_CHECKPOINT_PATH=/tmp/pulseops-checkpoints
